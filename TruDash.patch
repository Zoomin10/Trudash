diff --git a/tests/membershipAccess.test.cjs b/tests/membershipAccess.test.cjs
new file mode 100644
index 0000000..950ed98
--- /dev/null
+++ b/tests/membershipAccess.test.cjs
@@ -0,0 +1,39 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const express = require('express');
+const { createMembershipPilotRouter } = require('../routes/membershipPilot');
+async function scenario(t, admins, username, exportEmails = "") {
+ let calls = 0; let assertion;
+ const app = express(); app.use(express.json());
+ app.use((req,res,next) => { req.session = username ? {user:{username}} : {}; next(); });
+ app.use('/api/membership-pilot', createMembershipPilotRouter({env:{NODE_ENV:'production', MEMBERSHIP_PILOT_ENABLED:'true', MEMBERSHIP_PILOT_ADMIN_EMAILS:admins,TRUDASH_FULL_CSV_EXPORT_EMAILS:exportEmails,TCM_BACKEND_URL:'https://tcm.example',TCM_REGISTRATION_URL:'https://register.example',TRUDASH_MEMBERSHIP_SHARED_SECRET:'x'.repeat(40),APP_BASE_URL:'https://trudash.example'},fetchImpl:async(url,options)=>{assertion=options.headers["x-trudash-assertion"];calls++;return new Response(JSON.stringify({members:[]}),{headers:{'Content-Type':'application/json'}})}}));
+ const server = await new Promise(resolve => {const s=app.listen(0,'127.0.0.1',()=>resolve(s));});
+ t.after(()=>new Promise(resolve=>server.close(resolve)));
+ return {url:`http://127.0.0.1:${server.address().port}/api/membership-pilot`,calls:()=>calls, assertion:()=>assertion};
+}
+test('domain wildcard never exposes directory or CSV or volunteer records',async t=>{
+ const s=await scenario(t,'@wwfc.org.uk','coach@wwfc.org.uk');
+ assert.equal((await (await fetch(s.url+'/config')).json()).available,false);
+ for(const path of ['/members','/registrations.csv','/volunteers'])assert.equal((await fetch(s.url+path)).status,403);
+ assert.equal(s.calls(),0);
+});
+test('named administrator can read while anonymous users cannot',async t=>{
+ const named=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk');
+ const response=await fetch(named.url+'/members');assert.equal(response.status,200);assert.equal(response.headers.get('cache-control'),'no-store');assert.equal(named.calls(),1);
+ const anonymous=await scenario(t,'admin@wwfc.org.uk',null);assert.equal((await fetch(anonymous.url+'/members')).status,401);assert.equal(anonymous.calls(),0);
+});
+test('cross-origin mutations are rejected before forwarding',async t=>{
+ const s=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk');
+ assert.equal((await fetch(s.url+'/registrations/member1/billing/cancel',{method:'POST',headers:{Origin:'https://attacker.example'}})).status,403);assert.equal(s.calls(),0);
+});
+
+test('full CSV permission is separate from pilot administrator access and is signed',async t=>{
+ const denied=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk');
+ assert.equal((await fetch(denied.url+'/registrations.csv')).status,403);assert.equal(denied.calls(),0);
+ const allowed=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk','admin@wwfc.org.uk');
+ assert.equal((await fetch(allowed.url+'/registrations.csv')).status,200);
+ const claims=JSON.parse(Buffer.from(allowed.assertion().split('.')[1],'base64url').toString());
+ assert.equal(claims.fullCsvExport,true);assert.equal(claims.path,'/api/admin/registrations.csv');
+ const domain=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk','@wwfc.org.uk');
+ assert.equal((await fetch(domain.url+'/registrations.csv')).status,403);assert.equal(domain.calls(),0);
+});
