+  require(name){
+   if(name==='dotenv')return {config(){}};
+   if(name==='./services/sessionService')return {createSessionInfrastructure:()=>({middleware:(req,res,next)=>{req.session=req.headers['x-test-user']?{user:{username:req.headers['x-test-user']}}:{};next();},guard:(req,res,next)=>next()})};
