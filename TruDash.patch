+++ b/tests/privacyAccess.test.cjs
@@ -0,0 +1,54 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { namedUserAllowed, agreementAnalytics, complaintAnalytics } = require('../services/privacyAccess');
+test('personal access requires explicit matching email, never domain wildcard', () => {
+  assert.equal(namedUserAllowed('@wwfc.org.uk', 'coach@wwfc.org.uk'), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk, secretary@wwfc.org.uk', ' COACH@wwfc.org.uk '), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk, secretary@wwfc.org.uk', ' Chair@wwfc.org.uk '), true);
+  assert.equal(namedUserAllowed('', ''), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk', 'chair@wwfc.org.uk.evil'), false);
+});
+test('agreement response excludes member identities and future extra fields', () => {
+  const output = agreementAnalytics({ source: {fileName:'sensitive.xlsx',lastModifiedDateTime:'2026-10-14'}, agreements:[{documentName:'Agreement',version:'1',signed:10,pending:2,total:12,completionPercentage:83,pendingMembers:[{firstName:'Child'}],email:'private'}] });
+  assert.deepEqual(output, {source:{lastModifiedDateTime:'2026-10-14'},agreements:[{documentName:'Agreement',version:'1',signed:10,pending:2,total:12,completionPercentage:83}]});
+});
+test('complaint summary excludes linked case references and staff identities', () => {
+ assert.deepEqual(complaintAnalytics({openComplaints:2,cases:[{caseRef:'C1',caseOwner:'Person'}]}),{openComplaints:2,detailsRestricted:true});
+});
+const { createLoginAttempt, consumeLoginAttempt } = require('../services/loginFlow');
+test('login state is tied to the initiating session, expires and is consumed once', () => {
+ const attempt = createLoginAttempt(1000);
+ assert.notEqual(attempt.state, attempt.nonce);
+ assert.notEqual(attempt.state, createLoginAttempt(1000).state);
+ const session = {loginAttempt:attempt};
+ assert.equal(consumeLoginAttempt(session, attempt.state, 1001), attempt);
+ assert.equal(consumeLoginAttempt(session, attempt.state, 1001), null);
+ assert.equal(consumeLoginAttempt({loginAttempt:attempt}, 'attacker',1001),null);
+ assert.equal(consumeLoginAttempt({loginAttempt:attempt}, attempt.state,attempt.expiresAt),null);
+ assert.equal(consumeLoginAttempt({}, attempt.state,1001),null);
+});
+
+test('Microsoft code exchange receives the same expected nonce as sign-in', () => {
+ const fs = require('node:fs');
+ const vm = require('node:vm');
+ const source = fs.readFileSync(require('node:path').join(__dirname, '../server.js'), 'utf8');
+ const match = source.match(/acquireTokenByCode\((\{[\s\S]*?\})\);/);
+ assert.ok(match, 'code exchange exists');
+ const request = vm.runInNewContext('(' + match[1] + ')', {req:{query:{code:'code'}},authCodeUrlParameters:{scopes:['openid']},redirectUri:'https://example.org/auth/redirect',attempt:{nonce:'expected-nonce'}});
+ assert.equal(request.nonce, 'expected-nonce');
+ assert.equal(request.code, 'code');
+});
+const { collectionResponse } = require('../services/privacyAccess');
+test('ordinary collection response excludes identities, individual debts and unexpected nested fields', () => {
+ const input={totalOverdue:84,overdueMembers:[{firstName:'Child',lastName:'Private',teams:'U13',amountDue:21,clubOverdue:21,status:'overdue',email:'secret'}],unexpected:'private',months:[{month:'2026-10',collections:4,members:[{name:'Private'}]}]};
+ const output=collectionResponse(input);
+ assert.equal(output.totalOverdue,84);
+ assert.equal(output.canViewOverdueDetails,false);
+ assert.equal(Object.hasOwn(output,'overdueMembers'),false);
+ assert.equal(Object.hasOwn(output,'unexpected'),false);
+ assert.equal(Object.hasOwn(output.months[0],'members'),false);
+ assert.equal(JSON.stringify(output).includes('Private'),false);
+ const finance=collectionResponse(input,true);
+ assert.equal(finance.overdueMembers[0].firstName,'Child');
+ assert.equal(Object.hasOwn(finance.overdueMembers[0],'email'),false);
+});
