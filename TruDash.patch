+const test = require('node:test');
+const assert = require('node:assert/strict');
+const vm = require('node:vm');
+const fs = require('node:fs');
+const path = require('node:path');
+const http = require('node:http');
+const express = require('express');
+const privacy = require('../services/privacyAccess');
+test('real collection endpoint restricts personal arrears to named finance users', async t => {
+ let app;
+ const input = {totalOverdue:84,months:[],overdueMembers:[{firstName:'Private',lastName:'Child',amountDue:21,clubOverdue:21}]};
+ const env={TRUDASH_FINANCE_ADMIN_EMAILS:'treasurer@wwfc.org.uk'};
+ const source=fs.readFileSync(path.join(__dirname,'../server.js'),'utf8');
+ vm.runInNewContext(source,{
+  __dirname:path.join(__dirname,'..'),process:{env},console:{log(){},error(){}},Buffer,URL,Promise,
+  require(name){
+   if(name==='dotenv')return {config(){}};
+   if(name==='express'){
+    const factory=()=>{app=express();app.listen=()=>{};return app;};
+    factory.json=express.json;factory.static=express.static;return factory;
+   }
+   if(name==='express-session')return ()=> (req,res,next)=>{req.session=req.headers['x-test-user']?{user:{username:req.headers['x-test-user']}}:{};next();};
+   if(name==='./services/sharepointService')return {getTeamFeePayCollectionSummary:async()=>input};
+   if(name==='./services/applicationAccess')return {getApplicationAccess:async req=>({permissions: env.TRUDASH_FINANCE_ADMIN_EMAILS===req.session.user.username?['FINANCE_DETAILS']:[]})};
+   if(name==='./services/privacyAccess')return privacy;
+   if(name==='./services/loginFlow')return require('../services/loginFlow');
+   if(name==='./services/authService')return {};
+   if(name==='./routes/membershipPilot')return {createMembershipPilotRouter:()=>express.Router()};
+   return require(name);
+  }
+ });
+ const server=http.createServer(app);await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));
+ t.after(()=>new Promise(resolve=>server.close(resolve)));
+ const url=`http://127.0.0.1:${server.address().port}/api/members/collections`;
+ const ordinary=await fetch(url,{headers:{'x-test-user':'magic@wwfc.org.uk'}});
+ assert.equal(ordinary.status,200);assert.equal(ordinary.headers.get('cache-control'),'no-store');
+ const summary=await ordinary.json();assert.equal(summary.totalOverdue,84);assert.equal(summary.canViewOverdueDetails,false);assert.equal('overdueMembers' in summary,false);
+ const finance=await (await fetch(url,{headers:{'x-test-user':'treasurer@wwfc.org.uk'}})).json();assert.equal(finance.overdueMembers[0].firstName,'Private');
+ env.TRUDASH_FINANCE_ADMIN_EMAILS='@wwfc.org.uk';
+ assert.equal('overdueMembers' in await (await fetch(url,{headers:{'x-test-user':'magic@wwfc.org.uk'}})).json(),false);
+ assert.equal((await fetch(url)).status,401);
+});
