diff --git a/tests/retentionAccess.test.cjs b/tests/retentionAccess.test.cjs
new file mode 100644
index 0000000..e3a7b71
--- /dev/null
+++ b/tests/retentionAccess.test.cjs
@@ -0,0 +1,14 @@
+const test=require('node:test'),assert=require('node:assert/strict'),vm=require('node:vm'),fs=require('node:fs'),path=require('node:path');
+const express=require('express');
+async function fixture(t){let forwards=0;const mod={exports:{}};
+ vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../routes/membershipPilot.js'),'utf8'),{module:mod,Buffer,URL,AbortSignal,fetch,process,console,require(name){
+ if(name==='express')return express;if(name==='crypto')return require('node:crypto');
+ if(name==='../services/applicationAccess')return {getApplicationAccess:async req=>({permissions:req.session.user.username==='superonly'?[]:['MEMBERS_MANAGE'],superAdmin:req.session.user.username!=='memberonly'})};throw Error(name);
+ }});
+ const app=express();app.use((req,res,next)=>{req.session={user:{username:req.get('x-test-user')}};next();});
+ app.use('/api/membership-pilot',mod.exports.createMembershipPilotRouter({env:{MEMBERSHIP_PILOT_ENABLED:'true',TCM_BACKEND_URL:'https://backend.example',TCM_REGISTRATION_URL:'https://register.example',TRUDASH_MEMBERSHIP_SHARED_SECRET:'s'.repeat(40)},fetchImpl:async()=>{forwards++;return new Response('{"destructiveActionsEnabled":false}',{headers:{'Content-Type':'application/json'}});}}));
+ const server=await new Promise(resolve=>{const s=app.listen(0,'127.0.0.1',()=>resolve(s));});t.after(()=>new Promise(resolve=>server.close(resolve)));
+ return {call:(user,route='/retention-review')=>fetch(`http://127.0.0.1:${server.address().port}/api/membership-pilot${route}`,{headers:{'x-test-user':user}}),forwards:()=>forwards};
+}
+test('bridge requires Super Admin and member management before forwarding retention data',async t=>{const f=await fixture(t);assert.equal((await f.call('memberonly')).status,403);assert.equal((await f.call('superonly')).status,403);assert.equal(f.forwards(),0);assert.equal((await f.call('both')).status,200);assert.equal(f.forwards(),1);});
+test('report button permission is advertised only to the eligible identity',async t=>{const f=await fixture(t);for(const user of ['memberonly','superonly','both']){const body=await(await f.call(user,'/config')).json();assert.equal(body.retentionReviewAvailable,user==='both');}assert.equal(f.forwards(),0);});
