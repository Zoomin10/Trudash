@@ -0,0 +1,28 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const express = require('express');
+const { createMembershipPilotRouter } = require('../routes/membershipPilot');
+async function scenario(t, admins, username) {
+ let calls = 0;
+ const app = express(); app.use(express.json());
+ app.use((req,res,next) => { req.session = username ? {user:{username}} : {}; next(); });
+ app.use('/api/membership-pilot', createMembershipPilotRouter({env:{NODE_ENV:'production', MEMBERSHIP_PILOT_ENABLED:'true', MEMBERSHIP_PILOT_ADMIN_EMAILS:admins,TCM_BACKEND_URL:'https://tcm.example',TCM_REGISTRATION_URL:'https://register.example',TRUDASH_MEMBERSHIP_SHARED_SECRET:'x'.repeat(40),APP_BASE_URL:'https://trudash.example'},fetchImpl:async()=>{calls++;return new Response(JSON.stringify({members:[]}),{headers:{'Content-Type':'application/json'}})}}));
+ const server = await new Promise(resolve => {const s=app.listen(0,'127.0.0.1',()=>resolve(s));});
+ t.after(()=>new Promise(resolve=>server.close(resolve)));
+ return {url:`http://127.0.0.1:${server.address().port}/api/membership-pilot`,calls:()=>calls};
+}
+test('domain wildcard never exposes directory or CSV or volunteer records',async t=>{
+ const s=await scenario(t,'@wwfc.org.uk','coach@wwfc.org.uk');
+ assert.equal((await (await fetch(s.url+'/config')).json()).available,false);
+ for(const path of ['/members','/registrations.csv','/volunteers'])assert.equal((await fetch(s.url+path)).status,403);
+ assert.equal(s.calls(),0);
+});
+test('named administrator can read while anonymous users cannot',async t=>{
+ const named=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk');
+ const response=await fetch(named.url+'/members');assert.equal(response.status,200);assert.equal(response.headers.get('cache-control'),'no-store');assert.equal(named.calls(),1);
+ const anonymous=await scenario(t,'admin@wwfc.org.uk',null);assert.equal((await fetch(anonymous.url+'/members')).status,401);assert.equal(anonymous.calls(),0);
+});
+test('cross-origin mutations are rejected before forwarding',async t=>{
+ const s=await scenario(t,'admin@wwfc.org.uk','admin@wwfc.org.uk');
+ assert.equal((await fetch(s.url+'/registrations/member1/billing/cancel',{method:'POST',headers:{Origin:'https://attacker.example'}})).status,403);assert.equal(s.calls(),0);
+});
diff --git a/tests/privacyAccess.test.cjs b/tests/privacyAccess.test.cjs
new file mode 100644
index 0000000..870d312
--- /dev/null
+++ b/tests/privacyAccess.test.cjs
@@ -0,0 +1,29 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { namedUserAllowed, agreementAnalytics, complaintAnalytics } = require('../services/privacyAccess');
+test('personal access requires explicit matching email, never domain wildcard', () => {
+  assert.equal(namedUserAllowed('@wwfc.org.uk', 'coach@wwfc.org.uk'), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk, secretary@wwfc.org.uk', ' COACH@wwfc.org.uk '), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk, secretary@wwfc.org.uk', ' Chair@wwfc.org.uk '), true);
+  assert.equal(namedUserAllowed('', ''), false);
+  assert.equal(namedUserAllowed('chair@wwfc.org.uk', 'chair@wwfc.org.uk.evil'), false);
+});
+test('agreement response excludes member identities and future extra fields', () => {
+  const output = agreementAnalytics({ source: {fileName:'sensitive.xlsx',lastModifiedDateTime:'2026-10-14'}, agreements:[{documentName:'Agreement',version:'1',signed:10,pending:2,total:12,completionPercentage:83,pendingMembers:[{firstName:'Child'}],email:'private'}] });
+  assert.deepEqual(output, {source:{lastModifiedDateTime:'2026-10-14'},agreements:[{documentName:'Agreement',version:'1',signed:10,pending:2,total:12,completionPercentage:83}]});
+});
+test('complaint summary excludes linked case references and staff identities', () => {
+ assert.deepEqual(complaintAnalytics({openComplaints:2,cases:[{caseRef:'C1',caseOwner:'Person'}]}),{openComplaints:2,detailsRestricted:true});
+});
+const { createLoginAttempt, consumeLoginAttempt } = require('../services/loginFlow');
+test('login state is tied to the initiating session, expires and is consumed once', () => {
+ const attempt = createLoginAttempt(1000);
+ assert.notEqual(attempt.state, attempt.nonce);
+ assert.notEqual(attempt.state, createLoginAttempt(1000).state);
+ const session = {loginAttempt:attempt};
+ assert.equal(consumeLoginAttempt(session, attempt.state, 1001), attempt);
+ assert.equal(consumeLoginAttempt(session, attempt.state, 1001), null);
+ assert.equal(consumeLoginAttempt({loginAttempt:attempt}, 'attacker',1001),null);
+ assert.equal(consumeLoginAttempt({loginAttempt:attempt}, attempt.state,attempt.expiresAt),null);
+ assert.equal(consumeLoginAttempt({}, attempt.state,1001),null);
+});
