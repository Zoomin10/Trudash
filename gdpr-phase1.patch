diff --git a/services/loginFlow.js b/services/loginFlow.js
new file mode 100644
index 0000000..8f3b388
--- /dev/null
+++ b/services/loginFlow.js
@@ -0,0 +1,11 @@
+const crypto = require('node:crypto');
+function createLoginAttempt(now = Date.now()) {
+  return { state: crypto.randomBytes(32).toString('hex'), nonce: crypto.randomBytes(32).toString('hex'), expiresAt: now + 10 * 60 * 1000 };
+}
+function consumeLoginAttempt(session, state, now = Date.now()) {
+  const attempt = session.loginAttempt;
+  delete session.loginAttempt;
+  if (!attempt || typeof state !== 'string' || state !== attempt.state || attempt.expiresAt <= now) return null;
+  return attempt;
+}
+module.exports = { createLoginAttempt, consumeLoginAttempt };
diff --git a/services/privacyAccess.js b/services/privacyAccess.js
new file mode 100644
index 0000000..73f2254
--- /dev/null
+++ b/services/privacyAccess.js
@@ -0,0 +1,23 @@
+// Identity and permission are separate. Personal-data access requires named users.
+function namedUserAllowed(value, username) {
+  const email = String(username || "").trim().toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+$/.test(email)) return false;
+  return String(value || "").split(",").some(entry => {
+    const candidate = entry.trim().toLowerCase();
+    return /^[^\s@]+@[^\s@]+$/.test(candidate) && candidate === email;
+  });
+}
+function agreementAnalytics(summary) {
+  return {
+    source: { lastModifiedDateTime: summary.source?.lastModifiedDateTime || null },
+    agreements: (summary.agreements || []).map(item => ({
+      documentName: item.documentName, version: item.version,
+      signed: item.signed, pending: item.pending, total: item.total,
+      completionPercentage: item.completionPercentage,
+    })),
+  };
+}
+function complaintAnalytics(summary) {
+  return { openComplaints: summary.openComplaints, detailsRestricted: true };
+}
+module.exports = { namedUserAllowed, agreementAnalytics, complaintAnalytics };
